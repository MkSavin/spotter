# Copy to .env.bot in the repo root (`cp .env.bot.example .env.bot`).
# Used both locally (bun --env-file) and in containers (mounted at /app/.env).

# Timezone
TZ=Europe/Moscow

# Redis Streams Configuration (localhost for local runs; compose overrides this
# to redis://redis:6379 inside the Docker network).
REDIS_URL=redis://localhost:6379
REDIS_GROUP_ID=spotter-bot
REDIS_CLIENT_ID=spotter-bot

# Telegram Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Database Configuration (SQLite file path, relative to the working dir).
DATABASE_PATH=./data/bot.sqlite

# Default NVR source — the `<source>` used for camera commands and label
# rendering. Event media is routed by each event's own source; this is the
# fallback for frontend-initiated actions not tied to an event.
SOURCE_ID=frigate

# S3 Configuration — the bot holds NO NVR credentials. It only presigns the
# processed media keys depot produces into short-lived URLs for Telegram.
S3_HOST=https://s3.example.com
S3_ACCESS=your-access-key
S3_SECRET=your-secret-key
S3_BUCKET=spotter
# Lifetime (seconds) of the presigned media URLs handed to Telegram.
S3_PRESIGN_EXPIRY=3600
