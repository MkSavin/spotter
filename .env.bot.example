# Timezone
TZ=Europe/Moscow

# Kafka Configuration
KAFKA_CLIENT_ID=spotter-bot
KAFKA_BROKERS=kafka:29092
KAFKA_GROUP_ID=spotter-bot
KAFKA_ACTION_HEARTBEAT=3000
KAFKA_ACTION_TIMEOUT=30000

# Telegram Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Database Configuration (SQLite file path, relative to the bot working dir)
DATABASE_PATH=./data/bot.sqlite

# NVR Configuration
NVR_TYPE=frigate
FRIGATE_REMOTE_URL=http://your-frigate-host:5000
FRIGATE_AUTH_SECRET=your_frigate_auth_secret
FRIGATE_AUTH_USER=your_frigate_user

# Media Strategy
MEDIA_STRATEGY=link
