# ── email · layer 2 ───────────────────────────────────────────────────
# Service-specific overrides, layered on top of the shared `.env`
# (`cp .env.email.example .env.email`). Inherits REDIS_URL / S3_* / TZ.
#
# Optional frontend: an SMTP consumer of spotter.delivery.event. If you don't
# run apps/email, nothing else breaks. See apps/email/AGENTS.md.
REDIS_GROUP_ID=spotter-email

# ── SMTP transport ────────────────────────────────────────────────────
# Path A (recommended): a mailbox at a Russian provider (Yandex/Mail.ru).
# SPF/DKIM are already configured by the provider — no DNS setup, and the
# provider domain tends to stay reachable during "whitelist" shutdowns.
# Use an app-specific password, not your login password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# true = implicit TLS (465). false = STARTTLS upgrade (587/25).
SMTP_SECURE=true
SMTP_USER=alerts@yandex.ru
SMTP_PASSWORD=your_app_specific_password_here
# Envelope/From header. Address must match SMTP_USER for most providers.
SMTP_FROM=Spotter <alerts@yandex.ru>

# Comma-separated mailboxes every event is emailed to (channel-local
# addressing; the delivery stream carries no recipients).
EMAIL_RECIPIENTS=you@example.com,family@example.com

# always   — one email per `create` event, alongside other channels.
# fallback — reserved for the cross-channel ACK-trigger (not built yet;
#            currently behaves like `always`).
EMAIL_MODE=always

# Local dedup ledger (one row per emailed event) — survives restarts.
DATABASE_PATH=./data/email.sqlite

# Routing id + presign lifetime for the snapshot link in the email body.
SOURCE_ID=frigate
S3_PRESIGN_EXPIRY=3600

# Base URL of the web/PWA frontend; used for the "open event" deep link.
# Leave empty to omit the link.
PUBLIC_URL=
