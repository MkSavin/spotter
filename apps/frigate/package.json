{
  "name": "@spotter/frigate",
  "version": "1.4.0",
  "description": "Frigate NVR adapter (Source + MediaProvider + Catalog) on @spotter/sink",
  "main": "index.js",
  "scripts": {
    "start": "bun --env-file=../../.env src/index.ts",
    "start:watch": "bun --watch --env-file=../../.env src/index.ts",
    "build": "bun build --entrypoints src/index.ts --outdir ./dist --target bun --env disable",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "private": "true",
  "sideEffects": "false",
  "keywords": [],
  "author": "me@mksav.in",
  "license": "MIT",
  "dependencies": {
    "@spotter/sink": "*",
    "@spotter/transport": "*",
    "stenograph": "*",
    "mqtt": "^5.10.3"
  }
}
