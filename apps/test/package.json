{
  "name": "@spotter/test",
  "version": "1.1.0",
  "description": "Test NVR adapter — a REPL-driven source with local fixtures for offline pipeline development",
  "main": "index.js",
  "scripts": {
    "start": "bun --env-file=../../.env --env-file=../../.env.test src/index.ts",
    "start:watch": "bun --watch --env-file=../../.env --env-file=../../.env.test src/index.ts",
    "build": "bun build --entrypoints src/index.ts --outdir ./dist --target bun --env disable",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "private": "true",
  "sideEffects": "false",
  "keywords": [],
  "author": "me@mksav.in",
  "license": "MIT",
  "dependencies": {
    "@spotter/sink": "*",
    "@spotter/transport": "*",
    "stenograph": "*",
    "commander": "^13.1.0"
  }
}
