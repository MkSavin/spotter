generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
  output = "../../../.prisma-generated"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Chat {
  id            String   @id @map("_id")
  token         String
  authorizedAt  DateTime @default(now())
}

model User {
  id            String   @id @map("_id")
  chatId        String
  role          Role     @default(USER)
  token         String
  authorizedAt  DateTime @default(now())

  @@unique([id, chatId])
}

enum Role {
  USER
  ADMIN
}

type EventMessage {
  id                Int
  chatId            String
}

model Event {
  id                String  @id @map("_id")
  camera            String
  label             String?
  startTime         Float
  endTime           Float?
  score             Float
  stationary        Boolean @default(false)
  hasClip           Boolean @default(false)
  hasSnapshot       Boolean @default(false)
  type              String  @default("start")
  messages          EventMessage[]
}
