TELEGRAM_TOKEN=

NVR_TYPE=frigate

FRIGATE_REMOTE_URL=https://frigate.some-domain.com/
FRIGATE_AUTH_SECRET=
FRIGATE_AUTH_USER=spotter

AUTH_SECRET=somesecret

DATABASE_PATH=./data/bot.sqlite

REDIS_URL=redis://localhost:6379
REDIS_GROUP_ID=spotter-bot
REDIS_CLIENT_ID=@spotter/bot

# Optional tuning (defaults shown):
# REDIS_RECLAIM_MIN_IDLE_MS=300000 # 5m — keep above the longest media job
# REDIS_REAPER_INTERVAL_MS=60000   # 1m
# REDIS_MAX_DELIVERIES=5           # after N failed tries → <stream>.dead DLQ

MEDIA_STRATEGY=link # link | buffer | decide
