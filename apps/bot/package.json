{
  "name": "@spotter/bot",
  "version": "1.0.7",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "bun src/index.ts",
    "start:watch": "bun --watch src/index.ts",
    "build:bot": "bun build --entrypoints src/index.ts --outdir ./dist --target bun --env disable",
    "build:cli": "bun build --entrypoints src/cli.ts --outfile ./dist/spotter --target bun --env disable",
    "build": "bun run build:bot && bun run build:cli",
    "sign:token": "bun src/cli/sign.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "private": "true",
  "sideEffects": "false",
  "keywords": [],
