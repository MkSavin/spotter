  },
  "dependencies": {
    "@grammyjs/commands": "^1.0.5",
    "@grammyjs/hydrate": "^1.4.1",
    "@grammyjs/parse-mode": "^1.11.1",
    "@grammyjs/runner": "^2.0.3",
    "@spotter/transport": "*",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.35.0",
    "jsonwebtoken": "^9.0.2",    "stenograph": "*"
  }
