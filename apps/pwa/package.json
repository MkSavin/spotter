{
  "name": "@spotter/pwa",
  "version": "0.3.0",
  "description": "PWA frontend: delivery consumer that sends Web Push and serves the web app",
  "main": "index.js",
  "scripts": {
    "start": "bun --env-file=../../.env src/index.ts",
    "start:watch": "bun --watch --env-file=../../.env src/index.ts",
    "web:dev": "bun --bun vite web",
    "web:build": "bun --bun vite build web",
    "build": "bun run web:build && bun build --entrypoints src/index.ts --outdir ./dist --target bun --env disable",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "if [ -n \"$(find src -name '*.test.ts' 2>/dev/null)\" ]; then bun test src; fi",
    "test:coverage": "if [ -n \"$(find src -name '*.test.ts' 2>/dev/null)\" ]; then bun test src --coverage; fi"
  },
  "private": "true",
  "sideEffects": "false",
  "keywords": [],
  "author": "me@mksav.in",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@radix-ui/react-aspect-ratio": "^1.1.13",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-separator": "^1.1.13",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@spotter/transport": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "stenograph": "*",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  }
}
