  "main": "index.js",
  "scripts": {
    "start": "bun src/index.ts",
    "start:watch": "bun --watch src/index.ts",
    "build": "bun build --entrypoints ./src/index.ts --outdir ./dist --target bun --env disable",
    "sign:token": "bun src/cli/sign.ts",
    "prisma:generate": "bunx prisma generate",
    "docker:dev": "ln -sf docker-compose.development.yml docker-compose.yml",
    "docker:prod": "ln -sf docker-compose.production.yml docker-compose.yml",
    "docker:build": "docker build . --file Dockerfile",
    "docker:run": "docker run -it --rm $(docker build . -q --file Dockerfile)"
  },
  "private": "true",
  "keywords": [],
