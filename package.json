{
  "name": "spotter",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "turbo run start --parallel",
    "start:watch": "turbo run start:watch --parallel",
    "build": "turbo run build",
    "sign:token": "bun apps/bot/src/cli/sign.ts",
    "docker:dev": "ln -sf docker-compose.development.yml docker-compose.yml",
    "docker:prod": "ln -sf docker-compose.production.yml docker-compose.yml",
    "docker:build": "exit 1; docker build . --file apps/bot/Dockerfile",
    "docker:run": "exit 1; docker run -it --rm $(docker build . -q --file Dockerfile)"
  },
  "private": "true",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "bun@1.2.4",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "^2.4.4",
    "prisma": "^6.4.1"
  },
  "workspaces": ["apps/*", "packages/*"],
  "dependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^24.2.3"
  }
