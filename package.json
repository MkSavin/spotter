{
  "name": "spotter",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "turbo run start --parallel --filter=!@spotter/forwarder --filter=!@spotter/test",
    "start:watch": "turbo run start:watch --parallel --filter=!@spotter/forwarder --filter=!@spotter/test",
    "start:all": "turbo run start --parallel",
    "start:all:watch": "turbo run start:watch --parallel",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --parallel",
    "build": "turbo run build --parallel",
    "typecheck": "turbo run typecheck",
    "typecheck:full": "tsc --noEmit",
    "green": "turbo run typecheck test --affected && biome check",
    "sign:token": "bun apps/server/src/cli.ts sign",
    "changeset:conventional": "bun .integration/conventional.ts",
    "publish": "changeset git-tag",
    "docker:dev": "docker compose --project-directory . -f .deployment/compose/development.yml up -d"
  },
  "private": "true",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "bun@1.2.4",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@changesets/cli": "3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@manypkg/get-packages": "^3.1.0",
    "@types/bun": "^1.3.14",
    "@types/fluent-ffmpeg": "^2.1.28",
    "conventional-commits-parser": "^6.1.0",
    "turbo": "^2.4.4",
    "typescript": "7.0.2"
  },
  "workspaces": ["apps/*", "packages/*"],
  "dependencies": {
    "@types/node": "^25.9.3"
  }
}
