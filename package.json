{
  "name": "spotter",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "turbo run start --parallel",
    "start:watch": "turbo run start:watch --parallel",
    "test": "turbo run test --parallel",
    "build": "turbo run build --parallel",
    "sign:token": "bun apps/bot/src/cli/sign.ts",
    "docker:dev": "ln -sf docker-compose.development.yml docker-compose.yml",
    "docker:prod": "ln -sf docker-compose.production.yml docker-compose.yml",
    "docker:build": "exit 0; docker build . --file apps/bot/Dockerfile",
    "docker:run": "exit 0; docker run -it --rm $(docker build . -q --file Dockerfile)"
  },
  "private": "true",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "bun@1.2.4",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "prisma": "^6.4.1",
    "turbo": "^2.4.4",
    "zx-bulk-release": "^2.15.31"
  },
  "workspaces": ["apps/*", "packages/*"]
}
