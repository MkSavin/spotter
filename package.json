    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jsonwebtoken": "^9.0.9",
    "prisma": "^6.4.1"
  },
  "dependencies": {
    "@grammyjs/commands": "^1.0.5",
    "@grammyjs/hydrate": "^1.4.1",
    "@grammyjs/parse-mode": "^1.11.1",
    "@grammyjs/runner": "^2.0.3",
    "@prisma/client": "^6.4.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
