{
  "name": "spotter",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "bun --filter '!@spotter/{forwarder,test}' start",
    "start:watch": "bun --filter '!@spotter/{forwarder,test}' start:watch",
    "start:all": "bun --filter '*' start",
    "start:all:watch": "bun --filter '*' start:watch",
    "pretest": "bun .integration/rerun.ts --out=apps/pwa/web/dist/index.html --src='apps/pwa/web/src/**/*' --src='apps/pwa/web/index.html' --src='apps/pwa/web/vite.config.ts' -- bun --filter '@spotter/pwa' web:build",
    "test": "bun test apps packages",
    "test:coverage": "bun run pretest && bun test apps packages --coverage",
    "build": "bun --filter '*' build",
    "typecheck": "tsc --noEmit",
    "typecheck:full": "tsc --noEmit",
    "green": "tsc --noEmit && bun run test && biome check",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true",
    "sign:token": "bun apps/server/src/cli.ts sign",
    "changeset:conventional": "bun .integration/conventional.ts",
    "publish": "changeset git-tag",
    "docker:dev": "docker compose --project-directory . -f .deployment/compose/development.yml up -d",
    "test:e2e": "bun test ./.e2e/delivery.test.ts ./.e2e/recovery.test.ts",
    "smoke:build": "bun .e2e/smoke/build.ts",
    "test:smoke": "bun test ./.e2e/smoke.test.ts",
    "nvr:source": "./.e2e/nvr/source.sh",
    "nvr:build": "docker build --file apps/frigate/Dockerfile --build-arg APP_RELATIVE_PATH=apps/frigate --build-arg APP_PACKAGE_NAME=@spotter/frigate --tag spotter-nvr/frigate:test --load .",
    "test:nvr": "bun test ./.e2e/nvr.test.ts"
  },
  "private": "true",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@changesets/cli": "3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@manypkg/get-packages": "^3.1.0",
    "@types/bun": "^1.4.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "conventional-commits-parser": "^6.1.0",
    "lefthook": "^2.1.10",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/node": "^25.9.3"
  }
}
