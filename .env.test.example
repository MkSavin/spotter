# ── test · layer 2 ────────────────────────────────────────────────────
# Synthetic NVR adapter. Service-specific overrides, layered on top of the
# shared `.env` (`cp .env.test.example .env.test`). Inherits REDIS_URL /
# S3_* / TZ. Fixtures resolve to apps/test/data unless TEST_FIXTURE_* set.
REDIS_GROUP_ID=spotter-test
# Seeds the per-instance consumer name; override to run replicas side by side.
# REDIS_CLIENT_ID=spotter-test
SOURCE_ID=test
S3_STAGING_PREFIX=staging
