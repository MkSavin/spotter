# Copy to .env.test in the repo root (`cp .env.test.example .env.test`).
#
# The test adapter is a synthetic NVR for offline development: a REPL emits
# canonical events on demand and serves media from committed local fixtures
# (apps/test/data). It needs only Redis + S3 — no real NVR, MQTT or credentials.

# Redis Streams Configuration.
REDIS_URL=redis://localhost:6379
REDIS_GROUP_ID=spotter-test
REDIS_CLIENT_ID=spotter-test

# Routing id — the `<source>` in stream/key names and stamped onto every event.
SOURCE_ID=test

# S3 staging — raw fixture media is uploaded here for depot to transcode by key.
S3_HOST=http://localhost:9000
S3_ACCESS=spotter
S3_SECRET=change-me
S3_BUCKET=spotter
S3_STAGING_PREFIX=staging

# Optional fixture overrides (defaults to apps/test/data/{clip.mp4,snapshot.jpg,frame.jpg}).
# TEST_FIXTURE_CLIP=/abs/path/to/clip.mp4
# TEST_FIXTURE_SNAPSHOT=/abs/path/to/snapshot.jpg
# TEST_FIXTURE_FRAME=/abs/path/to/frame.jpg
