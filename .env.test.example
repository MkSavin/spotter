# Fake camera source for offline dev (no real NVR needed).
# Copy to `.env.test`. Loaded ON TOP of .env, by apps/test only.
# Everything else (Redis, S3, TZ) comes from .env.
# Test files are read from apps/test/data unless TEST_FIXTURE_* is set.

# This source is called "test", not "frigate", so events do not mix up.
SOURCE_ID=test
# Own queue name, so the test adapter does not steal frigate's messages.
REDIS_GROUP_ID=spotter-test
# Name of this copy. Change it to run two test adapters at once.
# REDIS_CLIENT_ID=spotter-test
# Folder in the bucket for raw files.
S3_STAGING_PREFIX=staging
