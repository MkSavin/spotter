# Copy to .env.depot in the repo root (`cp .env.depot.example .env.depot`).
# Used both locally (bun --env-file) and in containers (mounted at /app/.env).

# Redis Streams Configuration (localhost for local runs; compose overrides this
# to redis://redis:6379 inside the Docker network).
REDIS_URL=redis://localhost:6379
REDIS_GROUP_ID=spotter-depot
REDIS_CLIENT_ID=spotter-depot

# S3 Configuration (any S3-compatible backend)
S3_HOST=https://s3.example.com
S3_ACCESS=your-access-key
S3_SECRET=your-secret-key
S3_BUCKET=spotter

# Directory Cleanup Strategy: file-processed | process-exit
DIRECTORY_CLEANUP=file-processed

# Transcoding (Telegram rejects raw Frigate clips — keep conversion on).
VIDEO_SKIP_CONVERSION=false
VIDEO_ACCELERATION=cpu # cpu | vaapi | cuda | videotoolbox
VIDEO_CODEC=hevc # h264 | hevc
VIDEO_QUALITY=normal # best | good | normal | bad | awful
VIDEO_DEVICE=0

IMAGE_QUALITY=normal # best | good | normal | bad | awful
