# ── depot · layer 2 ───────────────────────────────────────────────────
# Service-specific overrides, layered on top of the shared `.env`
# (`cp .env.depot.example .env.depot`). Inherits REDIS_URL / S3_* / TZ.
REDIS_GROUP_ID=spotter-depot
# Seeds the per-instance consumer name; override to run replicas side by side.
# REDIS_CLIENT_ID=spotter-depot
# Reaper reclaims a pending entry after this idle window. Keep it ABOVE the
# longest transcode (VIDEO_TIMEOUT_MS) or a slow encode gets duplicated.
# REDIS_RECLAIM_MIN_IDLE_MS=300000

# When to delete the working directory: file-processed | process-exited.
DIRECTORY_CLEANUP=file-processed

# Transcoding (see apps/depot/AGENTS.md for the full matrix).
VIDEO_SKIP_CONVERSION=false
VIDEO_ACCELERATION=cpu # cpu | vaapi | cuda | videotoolbox
VIDEO_CODEC=hevc # h264 | hevc
VIDEO_QUALITY=normal # best | good | normal | bad | awful
VIDEO_DEVICE=0
# Hard cap per ffmpeg run; keep well below REDIS_RECLAIM_MIN_IDLE_MS.
VIDEO_TIMEOUT_MS=120000
IMAGE_QUALITY=normal # best | good | normal | bad | awful
