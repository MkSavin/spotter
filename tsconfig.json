{
  "compilerOptions": {
    "baseUrl": "./src",
    "outDir": "./lib",
    "target": "esnext",
    "module": "commonjs",
    "lib": [
      "esnext"
    ],
    "declaration": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "./src/*",
    "./src/bun.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
