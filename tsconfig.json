{
  "compilerOptions": {
    // Окружение: современный таргет, модули отдаёт бандлер (Bun)
    "target": "esnext",
    "lib": ["esnext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Эмитом занимается Bun (`bun build`), tsc используется только для проверки типов
    "noEmit": true,

    // Проверка типов
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,

    // Глобальные типы Bun (Bun.S3Client, bun:test и т.д.)
    "types": ["bun"]
  },
  "include": ["apps", "packages", "*.config.ts"],
  "exclude": ["node_modules", "**/dist", ".prisma-generated"]
}
