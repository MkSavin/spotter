# Copy to .env.frigate in the repo root (`cp .env.frigate.example .env.frigate`).
# Used both locally (bun --env-file) and in containers (mounted at /app/.env).
#
# The Frigate adapter is the ONLY component holding Frigate credentials. It runs
# next to Frigate at home and makes outbound connects only (Redis + S3); it
# stages raw media into S3 and never exposes tokens downstream.

# Redis Streams Configuration (localhost for local runs; compose overrides this
# to redis://redis:6379 inside the Docker network).
REDIS_URL=redis://localhost:6379
REDIS_GROUP_ID=spotter-frigate
REDIS_CLIENT_ID=spotter-frigate

# Routing id of this adapter instance — the `<source>` in stream/key names and
# the value stamped onto every emitted event (e.g. frigate, frigate-home).
SOURCE_ID=frigate

# Source Configuration (Frigate MQTT ingest)
SOURCE_TYPE=frigate
MQTT_BROKER=mqtt://localhost:1883

# Frigate media access (clip/snapshot/frame + /api/config for the catalog).
FRIGATE_REMOTE_URL=https://frigate.example.local
FRIGATE_AUTH_USER=admin
FRIGATE_AUTH_SECRET=change-me

# S3 staging — raw media is uploaded here for depot to transcode by key.
S3_HOST=http://localhost:9000
S3_ACCESS=spotter
S3_SECRET=change-me
S3_BUCKET=spotter
S3_STAGING_PREFIX=staging
