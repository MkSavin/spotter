# ── frigate · layer 2 ─────────────────────────────────────────────────
# Service-specific overrides, layered on top of the shared `.env`
# (`cp .env.frigate.example .env.frigate`). Inherits REDIS_URL / S3_* / TZ.
#
# This is the ONLY file that may hold NVR credentials (`FRIGATE_*`). They
# never belong in the shared `.env` — keep this adapter the sole holder.
REDIS_GROUP_ID=spotter-frigate
# Seeds the per-instance consumer name; override to run replicas side by side.
# REDIS_CLIENT_ID=spotter-frigate
SOURCE_ID=frigate
SOURCE_TYPE=frigate

# Prefix under which raw media is staged in the bucket before transcoding.
S3_STAGING_PREFIX=staging

MQTT_BROKER=mqtt://localhost:1883

# Frigate REST/media access — held ONLY here.
FRIGATE_REMOTE_URL=https://frigate.example.local
FRIGATE_AUTH_USER=admin
FRIGATE_AUTH_SECRET=change-me
