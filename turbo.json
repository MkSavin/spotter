{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^prisma:generate","^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "start": {
      "dependsOn": ["^prisma:generate"],
      "cache": false,
      "persistent": true
    },
    "start:watch": {
      "dependsOn": ["^prisma:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "test:coverage": {
      "cache": false
    },
    "prisma:generate": {
      "cache": false
    }
  }
}
