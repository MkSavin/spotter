# ═══════════════════════════════════════════════════════════════════════
#  Spotter — cloud machine (VPS): server + telegram (+ optional pwa/email)
# ═══════════════════════════════════════════════════════════════════════
#  Copy to `.env` ON THE CLOUD MACHINE and fill it in.
#  No camera passwords here — those stay on the ingest machine only.
#
#  MUST be real: S3_* and TELEGRAM_TOKEN.
# ═══════════════════════════════════════════════════════════════════════

# ── basics ──
# Which machine this is. The `spotter` command reads it. Do not change by hand.
SPOTTER_MODE=cloud
# Your timezone. Times in messages use it.
TZ=Europe/Moscow
# Redis = the pipe between services. Compose sets this up for you.
# Do NOT open it to the internet — ingest reaches it through an SSH tunnel.
REDIS_URL=redis://redis:6379
# Which address Redis listens on. Keep 127.0.0.1 — the SSH tunnel lands there.
REDIS_BIND=127.0.0.1

# ── storage (must be real) ──
# Where photos and videos live. Any S3 works.
S3_HOST=https://s3.example.com
S3_ACCESS=your_s3_access_key
S3_SECRET=your_s3_secret_key
S3_BUCKET=spotter

# ── telegram (must be real) ──
# Bot token from @BotFather.
TELEGRAM_TOKEN=your_telegram_bot_token_here
# How long a media link stays alive (seconds).
S3_PRESIGN_EXPIRY=3600

# ── pwa: phone/desktop app with push (optional) ──
# To turn on: uncomment spotter-pwa in production.cloud.yml.
# Push keys. install.ts makes them, or run by hand:
#   docker run --rm ghcr.io/mksavin/spotter-pwa bunx web-push generate-vapid-keys
# New pair = every device must subscribe again.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Site address. Put the app behind HTTPS — push does not work without it.
PUBLIC_URL=https://spotter.example.com
# Many events at once on one camera = one push. Window in ms.
PWA_COALESCE_MS=45000
# Codes that let a device turn on notifications. Empty = anyone can.
PWA_ACCESS_CODES=

# ── email: notifications by mail (optional) ──
# To turn on: uncomment spotter-email in production.cloud.yml.
# Use an app password, not your login password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# true = port 465. false = port 587 or 25.
SMTP_SECURE=true
SMTP_USER=alerts@yandex.ru
SMTP_PASSWORD=your_app_specific_password_here
# Shown as the sender. Most providers want it equal to SMTP_USER.
SMTP_FROM=Spotter <alerts@yandex.ru>
# Who gets the mail. Comma-separated.
EMAIL_RECIPIENTS=you@example.com
# always = mail on every event.
EMAIL_MODE=always
