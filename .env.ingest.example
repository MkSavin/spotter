# ═══════════════════════════════════════════════════════════════════════
#  Spotter — ingest machine (next to the cameras): frigate + depot + forwarder
# ═══════════════════════════════════════════════════════════════════════
#  Copy to `.env` ON THE INGEST MACHINE and fill it in.
#  Camera passwords (FRIGATE_*) live HERE ONLY — they never go to the cloud.
#
#  MUST be real: S3_*, FRIGATE_* and REDIS_REMOTE_URL (cloud Redis via SSH).
# ═══════════════════════════════════════════════════════════════════════

# ── basics ──
# Which machine this is. The `spotter` command reads it. Do not change by hand.
SPOTTER_MODE=ingest
# How often to look for new versions, in seconds. 86400 = once a day.
WATCHTOWER_INTERVAL=86400
# Your timezone. Times in messages use it.
TZ=Europe/Moscow
# Local Redis. It keeps events safe while the internet is down.
# Compose sets this up for you.
REDIS_URL=redis://local-redis:6379

# ── storage (must be real) ──
# Same S3 as on the cloud machine.
S3_HOST=https://s3.example.com
S3_ACCESS=your_s3_access_key
S3_SECRET=your_s3_secret_key
S3_BUCKET=spotter

# ── cameras (must be real, stays on this machine) ──
# Folder in the bucket for raw files, before they get converted.
S3_STAGING_PREFIX=staging
# Where your Frigate is, and how to log in.
FRIGATE_REMOTE_URL=https://frigate.example.local
FRIGATE_AUTH_USER=admin
FRIGATE_AUTH_SECRET=change-me
# Where Frigate shouts about events. Two ways:
#  1. Our own broker: leave as is. Frigate must reach it — put the Frigate
#     container on the `spotter-mqtt` network, or use MQTT_BIND/MQTT_PORT below.
#  2. You already have a broker: put its address here. In Docker, that is the
#     container name, e.g. mqtt://mosquitto:1883 — then also set MQTT_NETWORK
#     below. Not in Docker: mqtt://172.17.0.1:1883 (127.0.0.1 would mean the
#     container itself, not this machine). We do not start ours at all.
MQTT_BROKER=mqtt://mosquitto:1883
# Only for our own broker. Which address on THIS machine to open the port on.
# 127.0.0.1 = nobody outside can reach it (fine if Frigate is in Docker).
# 0.0.0.0 = anyone on your network can. Needed if Frigate is not in Docker.
MQTT_BIND=127.0.0.1
MQTT_PORT=1883
# Only for someone else's broker running in Docker. The name of ITS network —
# we join it so the broker's name resolves. `docker network ls` shows the names.
# Leave these two alone when the broker is ours.
MQTT_NETWORK=spotter-mqtt
MQTT_NETWORK_EXTERNAL=false

# ── video/photo converting (depot) ──
# Delete temp files right after each file is done.
DIRECTORY_CLEANUP=file-processed
# Who does the work: cpu is slow but always works. Got an NVIDIA card?
# Set cuda. No card? Start with `./spotter up --no-gpu`.
VIDEO_SKIP_CONVERSION=false
VIDEO_ACCELERATION=cpu # cpu | vaapi | cuda | videotoolbox
VIDEO_CODEC=hevc # h264 | hevc
VIDEO_QUALITY=normal # best | good | normal | bad | awful
VIDEO_DEVICE=0
# Give up on one video after this long (ms).
VIDEO_TIMEOUT_MS=120000
IMAGE_QUALITY=normal # best | good | normal | bad | awful

# ── link to the cloud machine (forwarder) ──
# Cloud Redis, reached through the SSH tunnel. Must be real.
# Usually the docker0 address, e.g. 172.17.0.1. See docs/deployment.md.
REDIS_REMOTE_URL=redis://172.17.0.1:6379
# Local Redis for the forwarder. Same as REDIS_URL above.
REDIS_LOCAL_URL=redis://local-redis:6379
# Which camera source to mirror to the cloud.
FORWARDER_SOURCES=frigate
