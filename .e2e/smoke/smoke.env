# Smoke configuration. Points every external at the fake NVR container, so a
# run cannot reach a camera, a chat, or anything outside this compose project.
S3_HOST=http://minio:9000
S3_ACCESS=spotter
S3_SECRET=spotter-smoke
S3_BUCKET=spotter

FRIGATE_REMOTE_URL=http://nvr:8080
FRIGATE_AUTH_USER=smoke
FRIGATE_AUTH_SECRET=smoke-secret
MQTT_BROKER=mqtt://mosquitto:1883


LOG_LEVEL=verbose
TZ=Europe/Moscow
