# ── forwarder · standalone ────────────────────────────────────────────
# The forwarder bridges TWO Redis hosts, so it does NOT layer the shared
# `.env` (there is no single REDIS_URL for it). Keep it self-contained
# (`cp .env.forwarder.example .env.forwarder`).

# Local-side Redis (durable AOF, localhost). Falls back to REDIS_URL if unset.
REDIS_LOCAL_URL=redis://local-redis:6379

# Remote-side Redis, reached over the fragile WAN hop (inside a VPN tunnel).
REDIS_REMOTE_URL=redis://10.0.0.1:6379

# Source ids whose per-source request streams are mirrored remote → local.
FORWARDER_SOURCES=frigate

# Optional tuning (shared REDIS_* block; defaults shown):
# REDIS_BLOCK_MS=5000
# REDIS_COUNT=10
# REDIS_RECLAIM_MIN_IDLE_MS=300000
# REDIS_REAPER_INTERVAL_MS=60000
# REDIS_MAX_DELIVERIES=5
# REDIS_MAXLEN=10000
