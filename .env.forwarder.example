# Copy to .env.forwarder in the repo root (`cp .env.forwarder.example .env.forwarder`).
# The forwarder is the only component that bridges the two Redis instances over
# the site-to-site VPN tunnel (ingest node ⇄ cloud node).

# Local-side Redis (durable AOF on the ingest node).
REDIS_LOCAL_URL=redis://local-redis:6379
# Cloud-side Redis, reached over the VPN tunnel.
REDIS_REMOTE_URL=redis://10.0.0.1:6379

# Sources whose per-source request streams (`spotter.{media,camera}.request.<source>`)
# are mirrored cloud → local so the owning adapter receives them. Comma-separated.
FORWARDER_SOURCES=frigate

# Shared Redis tuning (optional — sensible defaults apply).
# REDIS_MAXLEN=10000
