# Copy to .env.sink in the repo root (`cp .env.sink.example .env.sink`).
# Used both locally (bun --env-file) and in containers (mounted at /app/.env).

# Redis Streams Configuration (localhost for local runs; compose overrides this
# to redis://redis:6379 inside the Docker network).
REDIS_URL=redis://localhost:6379
REDIS_GROUP_ID=spotter-sink
REDIS_CLIENT_ID=spotter-sink

# Source Configuration (pluggable NVR source)
SOURCE_TYPE=frigate
MQTT_BROKER=mqtt://localhost:1883
