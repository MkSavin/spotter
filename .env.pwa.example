# ── pwa · layer 2 ─────────────────────────────────────────────────────
# Service-specific overrides, layered on top of the shared `.env`
# (`cp .env.pwa.example .env.pwa`). Inherits REDIS_URL / S3_* / TZ.
#
# The main frontend: a Web Push consumer of spotter.delivery.event that also
# serves the PWA. Optional like every frontend — see apps/pwa/AGENTS.md.
REDIS_GROUP_ID=spotter-pwa

# ── Web Push (VAPID) ──────────────────────────────────────────────────
# Generate your OWN keypair once: `bunx web-push generate-vapid-keys`.
# The public key is handed to the client at runtime via GET /api/vapid, so
# the built PWA works for any deployer without a rebuild. Keep the private
# key secret; rotating it invalidates every existing subscription.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ── HTTP + deep links ─────────────────────────────────────────────────
PORT=3000
# Canonical base URL (notification click target, deep links). Empty = relative.
PUBLIC_URL=https://spotter.example.com

# ── Dedup / storm control ─────────────────────────────────────────────
# Window that collapses a burst of events on one camera into a single
# "N событий" push (ms). Tune to your event rate.
PWA_COALESCE_MS=45000

# ── Device authorization (v1: local check) ────────────────────────────
# Comma-separated one-time codes that authorize a device on the setup
# screen. Empty disables the gate (every subscribed device gets pushes).
PWA_ACCESS_CODES=

# ── Storage ───────────────────────────────────────────────────────────
# Push subscriptions + dedup ledger + recent-events feed cache.
DATABASE_PATH=./data/pwa.sqlite

# Routing id + presign lifetime for snapshot/clip URLs in the feed.
SOURCE_ID=frigate
S3_PRESIGN_EXPIRY=3600
