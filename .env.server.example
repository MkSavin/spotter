# Copy to .env.server in the repo root (`cp .env.server.example .env.server`).
# Used both locally (bun --env-file) and in containers (mounted at /app/.env).

# Timezone
TZ=Europe/Moscow

# Redis Streams Configuration (localhost for local runs; compose overrides this
# to redis://redis:6379 inside the Docker network).
REDIS_URL=redis://localhost:6379
REDIS_GROUP_ID=spotter-server
REDIS_CLIENT_ID=spotter-server

# Database Configuration (SQLite file path, relative to the working dir).
# The domain DB: recipients, access tokens and persisted events.
DATABASE_PATH=./data/server.sqlite

# Default NVR source — the `<source>` used to bootstrap the catalog and route
# frontend-initiated camera actions not tied to a specific event. Event media
# is routed by each event's own source.
SOURCE_ID=frigate

# S3 Configuration — the server holds NO NVR credentials. It orchestrates the
# media pipeline over staged/processed S3 keys; it never touches the NVR.
S3_HOST=https://s3.example.com
S3_ACCESS=your-access-key
S3_SECRET=your-secret-key
S3_BUCKET=spotter
