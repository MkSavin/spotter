# ── Shared infrastructure · layer 1 of 2 ──────────────────────────────
# Copy to `.env`. Every co-located service loads THIS first, then its own
# `.env.<service>` on top (later file wins). Put values common to all
# services on one host here, so endpoints/credentials are declared ONCE.
#
# Security: NVR credentials never live here — `FRIGATE_*` stays in
# `.env.frigate` only. The forwarder bridges two Redis hosts and does not
# use this layer; see `.env.forwarder.example`.

TZ=Europe/Moscow

# Redis Streams transport — endpoint shared by every service. Per-service
# consumer group / client id live in the service layer; tuning knobs
# (REDIS_BLOCK_MS, REDIS_COUNT, REDIS_MAXLEN, …) default in code.
REDIS_URL=redis://localhost:6379

# Object storage (MinIO in dev, any S3-compatible endpoint in prod).
S3_HOST=http://localhost:9000
S3_ACCESS=spotter
S3_SECRET=spotter-dev
S3_BUCKET=spotter
