# ═══════════════════════════════════════════════════════════════════════
#  Spotter — one file for everything (modes: single / dev)
# ═══════════════════════════════════════════════════════════════════════
#  Copy to `.env` and fill it in. One file for the whole stack: compose
#  hands it to every container, extra variables are simply ignored.
#
#  MUST be real: S3_* (where media is kept) and TELEGRAM_TOKEN.
#  Everything else already works — change only if you want to.
#
#  Two machines instead of one? Use .env.cloud.example / .env.ingest.example.
# ═══════════════════════════════════════════════════════════════════════

# ── basics ──
# Which machine this is. The `spotter` command reads it. Do not change by hand.
SPOTTER_MODE=single
# Your timezone. Times in messages use it.
TZ=Europe/Moscow
# Redis = the pipe between services. Compose sets this up for you.
REDIS_URL=redis://redis:6379

# ── storage (must be real) ──
# Where photos and videos live. Any S3 works.
# Dev has a local MinIO in compose — the values below match it.
S3_HOST=http://localhost:9000
S3_ACCESS=spotter
S3_SECRET=spotter-dev
S3_BUCKET=spotter

# ── telegram (must be real) ──
# Bot token from @BotFather.
TELEGRAM_TOKEN=your_telegram_bot_token_here
# How long a media link stays alive (seconds).
S3_PRESIGN_EXPIRY=3600

# ── camera source (frigate) ──
# Folder in the bucket for raw files, before they get converted.
S3_STAGING_PREFIX=staging
# Where your Frigate is, and how to log in.
FRIGATE_REMOTE_URL=https://frigate.example.local
FRIGATE_AUTH_USER=admin
FRIGATE_AUTH_SECRET=change-me

# ── video/photo converting (depot) ──
# Delete temp files right after each file is done.
DIRECTORY_CLEANUP=file-processed
# true = do not convert video at all (Telegram may refuse such files).
VIDEO_SKIP_CONVERSION=false
# Who does the work: cpu is slow but always works.
# Full table is in apps/depot/AGENTS.md.
VIDEO_ACCELERATION=cpu # cpu | vaapi | cuda | videotoolbox
VIDEO_CODEC=hevc # h264 | hevc
VIDEO_QUALITY=normal # best | good | normal | bad | awful
VIDEO_DEVICE=0
# Give up on one video after this long (ms).
VIDEO_TIMEOUT_MS=120000
IMAGE_QUALITY=normal # best | good | normal | bad | awful

# ── pwa: phone/desktop app with push (optional) ──
# Skip this block if you do not run spotter-pwa.
# Push keys. install.ts makes them, or run by hand:
#   docker run --rm ghcr.io/mksavin/spotter-pwa bunx web-push generate-vapid-keys
# New pair = every device must subscribe again.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Site address, used for links in notifications. Empty = relative links.
PUBLIC_URL=
# Many events at once on one camera = one push. Window in ms.
PWA_COALESCE_MS=45000
# Codes that let a device turn on notifications. Empty = anyone can.
PWA_ACCESS_CODES=

# ── email: notifications by mail (optional) ──
# Skip this block if you do not run spotter-email.
# A mailbox at a big provider is easiest — nothing to set up in DNS.
# Use an app password, not your login password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# true = port 465. false = port 587 or 25.
SMTP_SECURE=true
SMTP_USER=alerts@yandex.ru
SMTP_PASSWORD=your_app_specific_password_here
# Shown as the sender. Most providers want it equal to SMTP_USER.
SMTP_FROM=Spotter <alerts@yandex.ru>
# Who gets the mail. Comma-separated.
EMAIL_RECIPIENTS=you@example.com
# always = mail on every event.
EMAIL_MODE=always
