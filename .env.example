# ═══════════════════════════════════════════════════════════════════════
#  Spotter — one file for everything (modes: single / dev)
# ═══════════════════════════════════════════════════════════════════════
#  Copy to `.env` and fill it in. One file for the whole stack: compose
#  hands it to every container, extra variables are simply ignored.
#
#  MUST be real: S3_* (where media is kept) and TELEGRAM_TOKEN.
#  Everything else already works — change only if you want to.
#
#  Two machines instead of one? Use .env.cloud.example / .env.ingest.example.
# ═══════════════════════════════════════════════════════════════════════

# ── basics ──
# Which machine this is. The `spotter` command reads it. Do not change by hand.
SPOTTER_MODE=single
# How often to look for new versions, in seconds. 86400 = once a day.
WATCHTOWER_INTERVAL=86400
# Your timezone. Times in messages use it.
TZ=Europe/Moscow
# Redis = the pipe between services. Compose sets this up for you.
REDIS_URL=redis://redis:6379

# ── storage (must be real) ──
# Where photos and videos live. Any S3 works.
# Dev has a local MinIO in compose — the values below match it.
S3_HOST=http://localhost:9000
S3_ACCESS=spotter
S3_SECRET=spotter-dev
S3_BUCKET=spotter

# ── telegram (must be real) ──
# Bot token from @BotFather.
TELEGRAM_TOKEN=your_telegram_bot_token_here
# How long a media link stays alive (seconds).
S3_PRESIGN_EXPIRY=3600

# ── camera source (frigate) ──
# Folder in the bucket for raw files, before they get converted.
S3_STAGING_PREFIX=staging
# Where your Frigate is, and how to log in.
FRIGATE_REMOTE_URL=https://frigate.example.local
# Где адаптер помнит запущенные экспорты таймлапсов. Должен лежать на томе:
# экспорт переживает рестарт, и без этого его некому будет дождаться.
# TIMELAPSE_STATE_PATH=/data/timelapse-exports.json
FRIGATE_AUTH_USER=admin
FRIGATE_AUTH_SECRET=change-me
# Where Frigate shouts about events. Two ways:
#  1. Our own broker: leave as is. Frigate must reach it — put the Frigate
#     container on the `spotter-mqtt` network, or use MQTT_BIND/MQTT_PORT below.
#  2. You already have a broker: put its address here. In Docker, that is the
#     container name, e.g. mqtt://mosquitto:1883 — then also set MQTT_NETWORK
#     below. Not in Docker: mqtt://172.17.0.1:1883 (127.0.0.1 would mean the
#     container itself, not this machine). We do not start ours at all.
MQTT_BROKER=mqtt://mosquitto:1883
# Only for our own broker. Which address on THIS machine to open the port on.
# 127.0.0.1 = nobody outside can reach it (fine if Frigate is in Docker).
# 0.0.0.0 = anyone on your network can. Needed if Frigate is not in Docker.
MQTT_BIND=127.0.0.1
MQTT_PORT=1883
# Only for someone else's broker running in Docker. The name of ITS network —
# we join it so the broker's name resolves. `docker network ls` shows the names.
# Leave these two alone when the broker is ours.
MQTT_NETWORK=spotter-mqtt
MQTT_NETWORK_EXTERNAL=false

# ── video/photo converting (depot) ──
# Delete temp files right after each file is done.
DIRECTORY_CLEANUP=file-processed
# true = do not convert video at all (Telegram may refuse such files).
VIDEO_SKIP_CONVERSION=false
# Who does the work: cpu is slow but always works.
# Full table is in apps/depot/AGENTS.md.
# cpu | vaapi | cuda | videotoolbox
VIDEO_ACCELERATION=cpu
# h264 | hevc
VIDEO_CODEC=hevc
# best | good | normal | bad | awful
VIDEO_QUALITY=normal
VIDEO_DEVICE=0
# Give up on one video after this long (ms).
VIDEO_TIMEOUT_MS=120000
# best | good | normal | bad | awful
IMAGE_QUALITY=normal
# Which media this depot takes: all | clips | snapshots. Single-node runs one
# depot, so leave it at `all`; the ingest profile splits the lanes across
# replicas so long videos do not delay snapshots.
DEPOT_LANE=all

# ── pwa: phone/desktop app with push (optional) ──
# Skip this block if you do not run spotter-pwa.
# Push keys. install.ts makes them, or run by hand:
#   docker run --rm ghcr.io/mksavin/spotter-pwa bunx web-push generate-vapid-keys
# New pair = every device must subscribe again.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Site address, used for links in notifications. Empty = relative links.
PUBLIC_URL=
# Port the pwa listens on inside its container.
PORT=3000
# Many events at once on one camera = one push. Window in ms.
PWA_COALESCE_MS=45000
# Codes that let a device turn on notifications. Empty = anyone can.

# ── what gets delivered (optional) ──
# all    = every event reaches you (default).
# alerts = only what Frigate itself flagged as an alert; what it calls a mere
#          detection is still recorded and visible in the feed, just not pushed.
#          Set up the zones and object filters in Frigate's own UI — Spotter
#          reads its verdict rather than second-guessing it with a threshold.
#          Needs Frigate 0.17+ (the `frigate/reviews` topic).
# DELIVERY_POLICY=all

# ── housekeeping (advanced, all optional) ──
# The defaults are fine. These bound how much history each service keeps: the
# SQLite files sit on the same disk as your recordings, so nothing grows forever.
# How long the domain keeps events it has already delivered (days).
# EVENT_RETENTION_DAYS=30
# How long the bot keeps the link between an event and its sent messages (days).
# Past this the message is far too old to still be edited.
# MESSAGE_RETENTION_DAYS=30
# How long an access code from /user_sign stays redeemable (hours).
# ACCESS_CODE_TTL_HOURS=24

# ── delivery tuning (advanced, all optional) ──
# The defaults are fine. Change them only if something misbehaves.
# A message no service managed to handle is retried, then parked in
# `<stream>.dead` after this many tries. Look there with:
#   docker compose exec redis redis-cli XRANGE spotter.event.dead - +
# REDIS_MAX_DELIVERIES=5
# How long a message may sit half-done before another worker picks it up (ms).
# Must stay ABOVE your slowest conversion — otherwise a long video gets
# converted twice. Raise it if you bumped VIDEO_TIMEOUT_MS above 120000.
# REDIS_RECLAIM_MIN_IDLE_MS=300000
# How often to look for such stuck messages (ms).
# REDIS_REAPER_INTERVAL_MS=60000
# How long to wait for new messages before looping (ms), and how many to take
# at a time.
# REDIS_BLOCK_MS=5000
# REDIS_COUNT=10
# How many messages to keep per stream. Older ones are dropped.
# REDIS_MAXLEN=10000

# ── email: notifications by mail (optional) ──
# Skip this block if you do not run spotter-email.
# A mailbox at a big provider is easiest — nothing to set up in DNS.
# Use an app password, not your login password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# true = port 465. false = port 587 or 25.
SMTP_SECURE=true
SMTP_USER=alerts@yandex.ru
SMTP_PASSWORD=your_app_specific_password_here
# Shown as the sender. Most providers want it equal to SMTP_USER.
SMTP_FROM=Spotter <alerts@yandex.ru>
# Who gets the mail. Comma-separated.
EMAIL_RECIPIENTS=you@example.com
# always = mail on every event.
EMAIL_MODE=always
