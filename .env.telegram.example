# ── telegram · layer 2 ────────────────────────────────────────────────
# Service-specific overrides, layered on top of the shared `.env`
# (`cp .env.telegram.example .env.telegram`). Inherits REDIS_URL / S3_* / TZ.
REDIS_GROUP_ID=spotter-telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
DATABASE_PATH=./data/telegram.sqlite
SOURCE_ID=frigate
# Lifetime (seconds) of presigned media URLs handed to Telegram.
S3_PRESIGN_EXPIRY=3600
